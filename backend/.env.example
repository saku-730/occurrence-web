# Bio Database backend environment example
# このファイルの値はすべて公開用のダミー値です。backend/.envへコピー後、実環境の値へ置き換えてください。

# Application
APP_HOST=0.0.0.0
APP_PORT=4001
APP_BASE_URL=https://api.example.invalid
APP_ENV=example
COOKIE_SECURE=true

# PostgreSQL
DATABASE_URL=postgres://example_user:example_password@postgres.example.invalid:5432/example_database

# Mail
SMTP_HOST=smtp.example.invalid
SMTP_PORT=2525
SMTP_USERNAME=example-smtp-user
SMTP_PASSWORD=example-smtp-password
SMTP_TLS=starttls
MAIL_FROM=no-reply@example.invalid

# Apache Jena Fuseki
FUSEKI_BASE_URL=https://fuseki.example.invalid/example-dataset
FUSEKI_USER=example-fuseki-user
FUSEKI_PASSWORD=example-fuseki-password
FUSEKI_DATASET=example-dataset
FUSEKI_URL=https://fuseki.example.invalid/example-dataset/data

# llama.cpp OpenAI-compatible API
LLAMA_CHAT_COMPLETIONS_URL=https://llama.example.invalid/v1/chat/completions
LLAMA_MODEL=example-vision-model

# Garage / S3-compatible object storage
OBJECT_STORE_BACKEND=example-s3-compatible-store
S3_ENDPOINT=https://garage.example.invalid
S3_REGION=example-region-1
S3_BUCKET=example-occurrence-media
S3_ACCESS_KEY=example-s3-access-key
S3_SECRET_KEY=example-s3-secret-key
S3_FORCE_PATH_STYLE=true

# Digital Agency ABR PostgreSQL
ABR_DATABASE_URL=postgres://example_abr_user:example_abr_password@abr-postgres.example.invalid:5432/example_abr_database
